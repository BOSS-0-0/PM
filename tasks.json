{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Process Manager (MSVC)",
            "type": "shell",
            "command": "cl",
            "args": [
                "/utf-8",
                "/EHsc",
                "/Fe:PM.exe",
                "main.cpp",
                "ProcessC.cpp",
                "ProcessCon.cpp",
                "/link",
                "psapi.lib"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}